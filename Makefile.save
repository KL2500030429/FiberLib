CC = gcc

CFLAGS = -Wall -Wextra -g -Iinclude

SRC = src/fiber.c \
      src/scheduler.c \
      src/context.c \
      src/queue.c

OBJ = $(SRC:.c=.o)

LIB = fiberlib.a

all: fiber_demo round_robin priority

priority: $(LIB) examples/priority.o
	$(CC) $(CFLAGS) examples/priority.o $(LIB) -o priority synchronization

synchronization: $(LIB) examples/synchronization.o
	$(CC) $(CFLAGS) examples/synchronization.o $(LIB) -o synchronization

$(LIB): $(OBJ)
	ar rcs $(LIB) $(OBJ)

fiber_demo: $(LIB) examples/basic.o
	$(CC) $(CFLAGS) examples/basic.o $(LIB) -o fiber_demo

round_robin: $(LIB) examples/round_robin.o
	$(CC) $(CFLAGS) examples/round_robin.o $(LIB) -o round_robin

src/%.o: src/%.c
	$(CC) $(CFLAGS) -c $< -o $@

examples/%.o: examples/%.c
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(OBJ) examples/*.o $(LIB) fiber_demo round_robin

run: all
	./round_rob
